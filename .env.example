# =============================================================================
# Copiá este archivo a .env y completá lo que necesites.
#
#   cp .env.example .env      (Git Bash)
#   copy .env.example .env    (PowerShell / CMD)
#
# Sirve para las dos formas de correr el proyecto:
#   - Docker Compose  → docker compose up -d --build
#   - Local (IntelliJ) → perfil `local`, con application-local.yaml
#
# Con Docker NO hace falta crear el .env: compose.yaml tiene un default
# razonable para cada variable. Copialo solo si querés cambiar algo.
# =============================================================================

# ── Base de datos ───────────────────────────────────────────────────────────
# Con Docker, compose arma la URL solo (apunta al servicio `db`).
# DB_URL solo se usa corriendo la app fuera de Docker.
DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_NAME=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=ecommerce
# Cambialo si ya tenés un Postgres propio ocupando el 5432 en Windows.
DB_PORT=5432

# ── Backend ─────────────────────────────────────────────────────────────────
APP_PORT=8080
# Mínimo 32 caracteres aleatorios. Para la entrega, generá uno nuevo.
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_chars
# true = la imagen Docker se buildea sin correr los tests (más rápido).
SKIP_TESTS=true

# ── Front (Progra 4) ────────────────────────────────────────────────────────
# Orígenes habilitados por CORS, separados por coma.
FRONT_ORIGINS=http://localhost:5173,http://localhost:3000
FRONT_PORT=5173
VITE_API_URL=http://localhost:8080/api/v1
# A dónde vuelve el navegador tras el login con GitHub.
# Vacío = el backend responde el JSON directo (cómodo para Postman).
OAUTH2_REDIRECT_URI=

# ── Mail ────────────────────────────────────────────────────────────────────
# En Docker el mail va SIEMPRE a Mailpit (http://localhost:8025): compose lo fija
# y no lee estas variables, para que las credenciales de Mailtrap de acá abajo
# no se filtren al contenedor. Estas son para correr FUERA de Docker.


MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ecommerce-blandi-arruti.com
# Mailpit no pide auth ni TLS; Mailtrap y Gmail sí.
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ── pgAdmin (docker compose --profile tools) ────────────────────────────────
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@ecommerce.com
PGADMIN_PASSWORD=admin

# ── MercadoPago (opcional) ──────────────────────────────────────────────────
# Sin token, los endpoints de pago con MP fallan pero el resto anda igual.
#
# Las dos URLs de abajo se arman SOLAS a partir de NGROK_DOMAIN (más abajo).
# Dejalas vacías salvo que quieras forzar otra cosa: si les ponés un valor,
# ese gana y NGROK_DOMAIN se ignora.
MP_ACCESS_TOKEN=
MP_NOTIFICATION_URL=
MP_BACK_URL=

# ── GitHub OAuth2 (opcional) ────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Correo Argentino (opcional) ─────────────────────────────────────────────
CORREO_ARGENTINO_USER_TOKEN=
CORREO_ARGENTINO_PASSWORD_TOKEN=
CORREO_ARGENTINO_CUSTOMER_ID=

# ── ngrok (docker compose --profile mp) ─────────────────────────────────────
# MercadoPago necesita una URL pública para avisar que se aprobó un pago:
# localhost no le sirve. ngrok publica el backend en internet.
#
# Sacá el token (gratis) en:
#   https://dashboard.ngrok.com/get-started/your-authtoken
# Y reclamá tu dominio estático (gratis, uno por cuenta) en:
#   https://dashboard.ngrok.com/domains
#
# El dominio estático no es opcional en la práctica: sin él ngrok te da una URL
# distinta en cada arranque y habría que reconfigurar MP en cada demo.
#
# Con NGROK_DOMAIN definido, MP_NOTIFICATION_URL y MP_BACK_URL se arman solas.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
NGROK_INSPECTOR_PORT=4040
