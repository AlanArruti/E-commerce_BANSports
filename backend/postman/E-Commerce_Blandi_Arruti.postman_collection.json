        {
          "name": "Listar Productos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/productos?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["productos"],
              "query": [
                {"key": "page", "value": "0"},
                {"key": "size", "value": "10"},
                {"key": "categoriaId", "value": "", "disabled": true},
                {"key": "precioMin", "value": "", "disabled": true},
                {"key": "precioMax", "value": "", "disabled": true},
                {"key": "search", "value": "", "disabled": true}
              ]
            }
          }
        },
        {
          "name": "Buscar Producto por ID",
          "request": {
