              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Remera Premium\",\n  \"descripcion\": \"Remera de algodón orgánico\",\n  \"precioBase\": 7999.99,\n  \"categoriaId\": 1\n}"
            },
            "url": {"raw": "{{baseUrl}}/productos/1", "host": ["{{baseUrl}}"], "path": ["productos", "1"]}
