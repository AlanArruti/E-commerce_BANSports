              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Remera Básica\",\n  \"descripcion\": \"Remera de algodón 100%\",\n  \"precioBase\": 5999.99,\n  \"categoriaId\": 1\n}"
            },
            "url": {"raw": "{{baseUrl}}/productos", "host": ["{{baseUrl}}"], "path": ["productos"]}
          }
        },
        {
          "name": "Actualizar Producto",
