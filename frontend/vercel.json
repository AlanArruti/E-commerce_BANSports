{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://bansports-api.onrender.com/api/:path*" },
    { "source": "/oauth2/:path*", "destination": "https://bansports-api.onrender.com/oauth2/:path*" },
    { "source": "/login/oauth2/:path*", "destination": "https://bansports-api.onrender.com/login/oauth2/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
